---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RoleCard from '../components/RoleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { sortByNewest } from '../lib/jobs';
import type { Job } from '../types/job';

export const prerender = true;

const entries = await getCollection('jobs');
const jobs: Job[] = sortByNewest(
    entries.map((entry) => ({ slug: entry.id, ...entry.data })),
);
const departments = [...new Set(jobs.map((job) => job.department))].sort();
const locations = [...new Set(jobs.map((job) => job.location))].sort();
---

<Layout title="Caldova Careers — Open roles">
  <div class="py-8">
    <section class="mb-10">
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Build the future of medicine</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        Caldova is an AI-native pharmaceutical company. Explore our open roles
        and help us bring better treatments to patients faster.
      </p>
    </section>

    <h2 class="text-2xl font-medium mb-6 text-slate-100">Open roles</h2>

    {jobs.length === 0 ? (
      <EmptyState text="There are no open roles right now. Check back soon." />
    ) : (
      <div data-testid="roles-listing" data-jobs={JSON.stringify(jobs)}>
        <fieldset class="mb-6 rounded-xl border border-slate-700 bg-slate-800/50 p-4">
          <legend class="px-2 text-sm font-semibold text-slate-200">Filter roles</legend>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
            <div>
              <label for="department-filter" class="mb-2 block text-sm text-slate-300">
                Department
              </label>
              <select
                id="department-filter"
                data-testid="department-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
              >
                <option value="">All departments</option>
                {departments.map((department) => <option value={department}>{department}</option>)}
              </select>
            </div>
            <div>
              <label for="location-filter" class="mb-2 block text-sm text-slate-300">
                Location
              </label>
              <select
                id="location-filter"
                data-testid="location-filter"
                class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
              >
                <option value="">All locations</option>
                {locations.map((location) => <option value={location}>{location}</option>)}
              </select>
            </div>
            <button
              type="button"
              data-testid="reset-filters"
              class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 hover:border-blue-400 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
            >
              Reset filters
            </button>
          </div>
        </fieldset>

        <div
          class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3"
          data-testid="roles-grid"
        >
          {jobs.map((job) => <RoleCard job={job} />)}
        </div>
        <div data-testid="filter-empty-state" hidden>
          <EmptyState text="No roles match your filters. Try changing or resetting your filters." />
        </div>
      </div>
    )}
  </div>
</Layout>

<script>
  import { filterJobs } from '../lib/jobs';
  import type { Job } from '../types/job';

  const listing = document.querySelector<HTMLElement>('[data-testid="roles-listing"]');
  const departmentFilter =
    document.querySelector<HTMLSelectElement>('[data-testid="department-filter"]');
  const locationFilter =
    document.querySelector<HTMLSelectElement>('[data-testid="location-filter"]');
  const resetButton = document.querySelector<HTMLButtonElement>('[data-testid="reset-filters"]');
  const rolesGrid = document.querySelector<HTMLElement>('[data-testid="roles-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');

  if (
    listing &&
    departmentFilter &&
    locationFilter &&
    resetButton &&
    rolesGrid &&
    emptyState
  ) {
    const jobs = JSON.parse(listing.dataset.jobs ?? '[]') as Job[];
    const roleCards = Array.from(
      rolesGrid.querySelectorAll<HTMLElement>('[data-testid="role-card"]'),
    );

    /** Apply the current filters to role visibility and the no-results message. */
    const updateVisibleRoles = (): void => {
      const matchingSlugs = new Set(
        filterJobs(jobs, {
          department: departmentFilter.value || undefined,
          location: locationFilter.value || undefined,
        }).map((job) => job.slug),
      );

      for (const card of roleCards) {
        card.hidden = !matchingSlugs.has(card.dataset.jobId ?? '');
      }

      const hasMatches = matchingSlugs.size > 0;
      rolesGrid.hidden = !hasMatches;
      emptyState.hidden = hasMatches;
    };

    departmentFilter.addEventListener('change', updateVisibleRoles);
    locationFilter.addEventListener('change', updateVisibleRoles);
    resetButton.addEventListener('click', () => {
      departmentFilter.value = '';
      locationFilter.value = '';
      updateVisibleRoles();
    });
  }
</script>
